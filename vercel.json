{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(favicon.png|og-image.jpg|og-image.png|favicon.ico|site.webmanifest|favicon-48.png|icon-192.png|apple-touch-icon.png|favicon-32.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ai-automation-services",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/n8n-workflow-automation",
      "destination": "/services/n8n-automation",
      "permanent": true
    },
    {
      "source": "/shopify-automation-services",
      "destination": "/services/shopify-automation",
      "permanent": true
    },
    {
      "source": "/nextjs-web-development",
      "destination": "/services/react-nextjs-development",
      "permanent": true
    },
    {
      "source": "/ai-agent-development",
      "destination": "/services/ai-agent-development",
      "permanent": true
    },
    {
      "source": "/portfolio-website-design",
      "destination": "/services/portfolio-website-design",
      "permanent": true
    },
    {
      "source": "/web-design-sharjah",
      "destination": "/services/web-design-sharjah",
      "permanent": true
    },
    {
      "source": "/ecommerce-website-development-uae",
      "destination": "/services/ecommerce-website-development-uae",
      "permanent": true
    },
    {
      "source": "/wordpress-development-dubai",
      "destination": "/services/wordpress-development-dubai",
      "permanent": true
    },
    {
      "source": "/website-redesign-uae",
      "destination": "/services/website-redesign-uae",
      "permanent": true
    }
  ]
}
